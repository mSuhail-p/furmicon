<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title>Furmicon | Verify OTP</title>
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <style>
    * {
      font-family: 'Poppins', sans-serif;
    }

    body {
      background: linear-gradient(135deg, rgba(15, 23, 42, 0.85), rgba(30, 41, 59, 0.85)), url(/assets/images/backgrounds/old.jpg);
      background-size: cover;
      background-position: center;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      margin: 0;
      padding: 30px 20px;
    }

    .otp-container {
      max-width: 440px;
      width: 100%;
      padding: 40px 30px;
      background: rgba(255, 255, 255, 0.95);
      border-radius: 20px;
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
      border: 1px solid rgba(255, 255, 255, 0.5);
    }

    .brand-header {
      text-align: center;
      margin-bottom: 25px;
    }

    .brand-header h2 {
      font-weight: 700;
      color: #1e293b;
      margin-bottom: 5px;
    }

    .brand-header p {
      color: #64748b;
      font-size: 0.9rem;
    }

    .otp-input {
      font-size: 1.6rem;
      letter-spacing: 12px;
      text-align: center;
      font-weight: 700;
      color: #1e293b;
      height: 55px;
      border-radius: 12px;
      border: 2px solid #cbd5e1;
      transition: all 0.3s ease;
    }

    .otp-input:focus {
      border-color: #2563eb;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
    }

    .timer-badge {
      background: #f1f5f9;
      color: #475569;
      font-size: 0.88rem;
      font-weight: 500;
      padding: 8px 16px;
      border-radius: 20px;
      display: inline-block;
    }

    .btn-submit {
      height: 48px;
      border-radius: 10px;
      background: #2563eb;
      border: none;
      font-weight: 600;
      font-size: 1rem;
      letter-spacing: 0.5px;
      transition: all 0.3s ease;
    }

    .btn-submit:hover {
      background: #1d4ed8;
      transform: translateY(-1px);
    }

    .btn-resend {
      height: 42px;
      border-radius: 10px;
      font-weight: 600;
      font-size: 0.9rem;
    }
  </style>
</head>

<body>
  <div class="otp-container">
    <div class="brand-header">
      <h2>Verify OTP</h2>
      <p>Please enter the 4-digit code sent to your registered email</p>
    </div>

    <form action="/verify" method="post" id="otpForm">
      <div class="form-group mb-4">
        <input type="text" class="form-control otp-input" name="otp" id="otpInput" maxlength="4" placeholder="••••" required autofocus autocomplete="off">
      </div>

      <div class="text-center mb-4">
        <div class="timer-badge" id="timer">
          Time remaining: <span id="countdown" class="font-weight-bold text-primary">60</span>s
        </div>
      </div>

      <button type="submit" class="btn btn-primary btn-block btn-submit mb-3">Verify Code</button>

      <div class="text-center">
        <button type="button" class="btn btn-outline-secondary btn-block btn-resend" id="resendBtn" onclick="resendOTP()" disabled>
          <i class="fas fa-redo-alt mr-1"></i> Resend OTP
        </button>
      </div>
    </form>
  </div>

  <% if (typeof message != 'undefined' && message) { %>
    <script>
      Swal.fire({
        title: 'Verification Notice',
        text: '<%= message %>',
        icon: 'error',
        confirmButtonColor: '#2563eb'
      });
    </script>
  <% } %>

  <% if (typeof expires != 'undefined' && expires) { %>
    <script>
      Swal.fire({
        title: 'OTP Expired',
        text: '<%= expires %>',
        icon: 'warning',
        confirmButtonColor: '#2563eb'
      });
    </script>
  <% } %>

  <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

  <script>
    let timer;

    function startTimer() {
      clearInterval(timer);
      let countdown = 60;
      const timerElem = document.getElementById('timer');
      const resendBtn = document.getElementById('resendBtn');
      
      if (timerElem) {
        timerElem.innerHTML = "Time remaining: <span id='countdown' class='font-weight-bold text-primary'>60</span>s";
      }
      if (resendBtn) resendBtn.disabled = true;

      timer = setInterval(function () {
        countdown--;
        const cdElem = document.getElementById('countdown');
        if (cdElem) cdElem.innerText = countdown;

        if (countdown <= 0) {
          clearInterval(timer);
          if (timerElem) timerElem.innerHTML = "<span class='text-danger font-weight-bold'>OTP Expired. Please request a new code.</span>";
          if (resendBtn) resendBtn.disabled = false;
        }
      }, 1000);
    }
    
    startTimer();

    function resendOTP() {
      const resendBtn = document.getElementById('resendBtn');
      resendBtn.disabled = true;

      fetch('/resend', {
        method: 'GET',
        headers: {
          'Content-Type': 'application/json'
        }
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          Swal.fire({
            title: 'Success',
            text: data.message || 'A new OTP has been sent to your email.',
            icon: 'success',
            timer: 2500,
            showConfirmButton: false
          });
          startTimer();
        } else {
          Swal.fire({
            title: 'Error',
            text: data.message || 'Failed to resend OTP.',
            icon: 'error',
            confirmButtonColor: '#2563eb'
          });
          resendBtn.disabled = false;
        }
      })
      .catch(error => {
        console.error('Resend OTP error:', error);
        Swal.fire({
          title: 'Error',
          text: 'Network error while resending OTP. Please try again.',
          icon: 'error',
          confirmButtonColor: '#2563eb'
        });
        resendBtn.disabled = false;
      });
    }
  </script>
</body>

</html>